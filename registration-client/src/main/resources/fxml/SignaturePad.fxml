<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root"
          maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
          prefHeight="420.0" prefWidth="616.0"
          style="-fx-background-color : white;-fx-text-fill : black;-fx-font-size: 1.3em;-fx-border-width : 1.0;-fx-border-color : black;"
          styleClass="scanPage" xmlns="http://javafx.com/javafx/17.0.2-ea"
          fx:controller="io.mosip.registration.controller.reg.SignaturePadController">

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="100.0" prefWidth="100.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" percentHeight="100.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>

    <children>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="100.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" percentHeight="80.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>

            <children>
                <!-- Header -->
                <GridPane prefHeight="29.0" prefWidth="232.0" style="-fx-background-color: #147f55; -fx-text-fill: white;" styleClass="documentScanHeader">
                    <children>
                        <Label fx:id="popupTitle" prefHeight="27.0" prefWidth="431.0" style="-fx-text-fill: white;-fx-font-weight: bold;" styleClass="scanPopupHeaderTitle" text="SIGNATURE PAD" GridPane.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <Hyperlink fx:id="closeButton" onAction="#cancelSignature" style="-fx-text-fill: white; -fx-font-weight: bold;" styleClass="exit" GridPane.columnIndex="1">
                            <graphic>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/DocumentClose.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <font>
                                <Font size="18.0"/>
                            </font>
                        </Hyperlink>
                    </children>
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="589.0" minWidth="10.0" percentWidth="95.0" prefWidth="337.0"/>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="302.0" minWidth="10.0" percentWidth="5.0" prefWidth="46.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" percentHeight="100.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                </GridPane>

                <!-- Signature Body -->
                <GridPane GridPane.rowIndex="1">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="100.0" prefWidth="100.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" percentHeight="100.0" prefHeight="30.0" vgrow="ALWAYS"/>
                    </rowConstraints>

                    <children>

                        <VBox spacing="30" alignment="CENTER" style="-fx-padding: 30;" maxWidth="-Infinity" minWidth="-Infinity">

                            <!-- Border Pane for canvas and image -->
                            <StackPane fx:id="canvasPane" prefHeight="200.0" prefWidth="400.0" alignment="CENTER"
                                       style="-fx-border-color: #147f55; -fx-border-width: 2px; -fx-background-color: white;">

                                <!-- Signature image, centered -->
                                <ImageView style="-fx-alignment: center;" fx:id="signatureImageView"
                                           fitWidth="480.0"
                                           fitHeight="200.0"
                                           preserveRatio="true"
                                           pickOnBounds="true"
                                           smooth="true" />
                            </StackPane>

                   <HBox spacing="20" alignment="CENTER">

                                <Button text="Sign Here" fx:id="saveButton" onAction="#signatureMethode" prefWidth="120" style="-fx-background-color: #147f55; -fx-text-fill: white;"/>
                                <CheckBox fx:id="exceptionCheckBox" wrapText="true" text="Signature Exception" onAction="#handleExceptionCheckBox"/>


                                <!--                                <Button text="Clear" fx:id="clearButton" onAction="#clearCanvas" prefWidth="100" style="-fx-background-color: #888888; -fx-text-fill: white;"/>-->
                            </HBox>

<!--                            <HBox fx:id="thumbsHbox" visible="false">-->
<!--                                <Label>Select the Finger Option     : </Label>-->
<!--                                <ComboBox   fx:id="thumbsComboBox" prefWidth="200" visible="false" />-->

<!--                                <Button text="Capture" fx:id="captureFinger" onAction="#captureSingleFinger" prefWidth="120" visible="false"-->
<!--                                        style="-fx-background-color: #147f55; -fx-text-fill: white;"/>-->
<!--                            </HBox>-->
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </GridPane>
    </children>
</GridPane>
