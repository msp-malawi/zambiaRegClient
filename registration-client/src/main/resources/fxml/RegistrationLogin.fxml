<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" id="loginScreen" prefHeight="900.0" prefWidth="600.0"
			styleClass="loginBorderPaneStyle loginRoot" xmlns="http://javafx.com/javafx/17.0.2-ea"
			fx:controller="io.mosip.registration.controller.auth.LoginController">
	<top>
		<HBox fx:id="header" prefHeight="1.0" prefWidth="1.0" visible="false" managed="false"/>
	</top>
	<center>
		<StackPane styleClass="loginCenterWrap">
			<VBox fx:id="card" alignment="CENTER" styleClass="loginMainCardWrap">
				<FlowPane alignment="CENTER" prefWrapLength="900.0" styleClass="loginMainCard">
					<VBox alignment="TOP_LEFT" spacing="10" styleClass="loginSidePanel">
						<ImageView fitHeight="55.0" fitWidth="70.0" preserveRatio="true">
<!--							<image>-->
<!--								<Image url="@/images/LOGO2.png"/>-->
<!--							</image>-->
						</ImageView>
						<Label styleClass="loginSideTitle" text="Let's Grow Up"/>
						<Label styleClass="loginSideTitle" text="Your Future"/>
						<Label styleClass="loginSideTitle" text="With Registration Client"/>
						<Label styleClass="loginSideBody" text="Learn important new skills, discover passions, and build secure identity services."/>
						<ImageView fitHeight="260.0" fitWidth="300.0" preserveRatio="true">
							<image>
								<Image url="@/images/LOGO1.png"/>
							</image>
						</ImageView>
					</VBox>

					<VBox alignment="CENTER" spacing="12" styleClass="loginFormPanel">
						<VBox alignment="CENTER" spacing="4" styleClass="loginFormBrand">
							<ImageView fitHeight="28.0" fitWidth="34.0" preserveRatio="true">
								<image>
									<Image url="@/images/LOGO1.png"/>
								</image>
							</ImageView>
							<Label styleClass="loginFormSubtitle" text="Integrated National"/>
							<Label styleClass="loginFormSubtitle" text="Registration"/>
							<Label styleClass="loginFormSubtitle" text="Information System"/>
						</VBox>
						<Label styleClass="loginFormTitle loginFormTitleCenter" text="Sign in to your account"/>
<!--						<Label styleClass="loginFormSubtitle" text="Integrated National Registration Information System"/>-->

						<VBox alignment="CENTER" spacing="4" >
							<AnchorPane fx:id="userIdPane"  visible="true">
								<TextField fx:id="userId"
										   promptText="%withusername" styleClass="loginTextStyle"
										   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"/>
								<StackPane styleClass="loginLoaderOverlay" mouseTransparent="true"
										   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
										   AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
									<ProgressIndicator fx:id="progressIndicator" progress="0.0" visible="false"/>
								</StackPane>
							</AnchorPane>

							<AnchorPane fx:id="credentialsPane" visible="true">
								<StackPane AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
									<PasswordField fx:id="password"
												   promptText="%withpword"
												   focusTraversable="true"
												   styleClass="loginTextStyle"
												   maxWidth="Infinity"
												   StackPane.alignment="CENTER_LEFT"/>

									<TextField fx:id="visiblePasswordField"
											   promptText="%withpword"
											   text="Admin@123"
											   visible="false"
											   managed="false"
											   focusTraversable="true"
											   styleClass="loginTextStyle"
											   maxWidth="Infinity"
											   StackPane.alignment="CENTER_LEFT"/>

									<ImageView fx:id="toggleEye"
											   fitHeight="18" fitWidth="18"
											   pickOnBounds="true"
											   preserveRatio="true"
											   StackPane.alignment="CENTER_RIGHT"
											   translateX="-10"
											   styleClass="loginToggleEye">
										<image>
											<Image url="@../images/passwordEyeClose.png"/>
										</image>
									</ImageView>
								</StackPane>
								<StackPane styleClass="loginLoaderOverlay" mouseTransparent="true"
										   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
										   AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
									<ProgressIndicator fx:id="passwordProgressIndicator" progress="0.0" visible="false"/>
								</StackPane>
							</AnchorPane>

							<HBox alignment="CENTER">
								<Button mnemonicParsing="false" onAction="#validateCredentials"
										styleClass="loginSubmitStyle" text="Login"/>
							</HBox>
						</VBox>

						<AnchorPane fx:id="otpPane" prefHeight="297.0" prefWidth="366.0"
									styleClass="loginAnchorPaneExtendedStyle" visible="false" managed="false">
							<children>
								<PasswordField fx:id="otp" layoutX="57.0" layoutY="96.0" onAction="#validateOTP"
											   promptText="%enterotp" styleClass="loginTextStyle" AnchorPane.leftAnchor="53.0"/>
								<Button fx:id="getOTP" layoutX="53.0" layoutY="144.0" mnemonicParsing="false"
										onAction="#generateOtp" styleClass="loginSubmitStyle" text="%getotp" visible="true"/>
								<Button fx:id="resend" layoutX="53.0" layoutY="144.0" mnemonicParsing="false"
										onAction="#generateOtp" styleClass="loginSubmitStyle" text="%resendotp"
										visible="false"/>
								<Button fx:id="otpSubmit" disable="true" layoutX="53.0" layoutY="195.0" mnemonicParsing="false"
										onAction="#validateOTP" styleClass="loginSubmitStyle" text="%submit"/>
								<Label fx:id="otpValidity" layoutX="60.0" layoutY="245.0" styleClass="loginOtpValidStyle"
									   visible="false"/>
								<Hyperlink layoutX="52.0" layoutY="234.0" mnemonicParsing="false" onAction="#back"
										   styleClass="hyperLinkStyle" text="%back"/>
							</children>
						</AnchorPane>
						<AnchorPane fx:id="fingerprintPane" prefHeight="192.0" prefWidth="207.0"
									styleClass="loginAnchorPaneStyle" visible="false" managed="false">
							<children>
								<Label layoutX="57.0" layoutY="75.0" text="%withfingerprint"/>
								<Button fx:id="submit" layoutX="57.0" layoutY="170.0" mnemonicParsing="false"
										onAction="#captureFingerPrint" styleClass="loginSubmitStyle" text="%submit"/>
								<ImageView fitHeight="59.0" fitWidth="53.0" layoutX="180.0" layoutY="102.0" pickOnBounds="true"
										   preserveRatio="true">
									<image>
										<Image url="@../images/FingerprintScan.png"/>
									</image>
								</ImageView>
								<Hyperlink layoutX="52.0" layoutY="222.0" mnemonicParsing="false" onAction="#back"
										   styleClass="hyperLinkStyle" text="%back"/>
								<ProgressIndicator fx:id="fpProgressIndicator" layoutX="130.0" layoutY="50.0" progress="0.0"
												   visible="false"/>
							</children>
						</AnchorPane>
						<AnchorPane fx:id="irisPane" prefHeight="242.0" prefWidth="379.0"
									styleClass="loginAnchorPaneStyle" visible="false" managed="false">
							<children>
								<Label layoutX="57.0" layoutY="76.0" text="%withiris"/>
								<Button layoutX="57.0" layoutY="174.0" mnemonicParsing="false" onAction="#captureIris"
										styleClass="loginSubmitStyle" text="%submit"/>
								<ImageView fitHeight="59.0" fitWidth="53.0" layoutX="180.00" layoutY="102.0" pickOnBounds="true"
										   preserveRatio="true">
									<image>
										<Image url="@../images/Eyescan.png"/>
									</image>
								</ImageView>
								<Hyperlink layoutX="52.0" layoutY="222.0" mnemonicParsing="false" onAction="#back"
										   styleClass="hyperLinkStyle" text="%back"/>
								<ProgressIndicator fx:id="irisProgressIndicator" layoutX="130.0" layoutY="50.0" progress="0.0"
												   visible="false"/>
							</children>
						</AnchorPane>
						<AnchorPane fx:id="facePane" prefHeight="510.0" prefWidth="458.0"
									styleClass="loginAnchorPaneStyle" visible="false" managed="false">
							<children>
								<Label layoutX="35.0" layoutY="71.0" text="%withface"/>
								<Button layoutX="100.0" layoutY="375.0" mnemonicParsing="false" onAction="#captureFace"
										styleClass="loginSubmitStyle2" text="%submit"/>
								<Button layoutX="220.0" layoutY="375.0" mnemonicParsing="false" onAction="#streamFace"
										styleClass="loginSubmitStyle2" text="Stream"/>
								<ImageView fx:id="faceImage" fitHeight="230.0" fitWidth="230.0" layoutX="75.0" layoutY="113.0"
										   pickOnBounds="true" preserveRatio="true">
									<image>
										<Image url="@../images/FaceScan.png"/>
									</image>
								</ImageView>
								<Hyperlink layoutX="38.0" layoutY="390.0" mnemonicParsing="false" onAction="#back"
										   styleClass="hyperLinkStyle" text="%back"/>
								<ProgressIndicator fx:id="faceProgressIndicator" layoutX="130.0" layoutY="50.0" progress="0.0"
												   visible="false"/>
							</children>
						</AnchorPane>
						<AnchorPane fx:id="errorPane" styleClass="loginAnchorPaneStyle" visible="false" managed="false">
							<children>
								<Label prefWidth="300.0" text="%internalsystemerror.pleasecontactadmin."/>
							</children>
						</AnchorPane>
					</VBox>
				</FlowPane>
			</VBox>
		</StackPane>
	</center>

	<bottom>
		<HBox id="footer-section" alignment="CENTER" spacing="10" visible="false" managed="false"
			  style="-fx-background-color: #147f55; -fx-padding: 10;">
			<ImageView fitHeight="25.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
				<image>
					<Image url="@/images/msp-logo.png"/>
				</image>
			</ImageView>
			<Label style="-fx-text-fill: white;" text="%mosip.io"/>
			<Label style="-fx-text-fill: white;" text="  "/>
			<Label style="-fx-text-fill: white;" text="%regClientVersion">
				<font>
					<Font name="System Bold" size="12.0"/>
				</font>
			</Label>
			<Label style="-fx-text-fill: white;" text=" : "/>
			<Label fx:id="versionValueLabel" style="-fx-text-fill: white;" />
		</HBox>
	</bottom>
</BorderPane>
